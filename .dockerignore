# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo

# Ignore environment files (but include .env.example if applicable)
.env
!.env.example

# Ignore Git files
.git/
.gitignore

# Ignore Docker configuration files (usually not needed inside the container)
Dockerfile
docker-compose.yml

# Ignore log files
*.log

# Ignore temporary or backup files
*.bak
*.swp
*.tmp

# Ignore IDE or editor-specific files
*.idea/
.vscode/
*.DS_Store

# Ignore node_modules (if using JavaScript/TypeScript in the project)
node_modules/

# Ignore build output (if applicable)
build/
dist/
